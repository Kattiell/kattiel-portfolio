# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# oficina do Blender: arquivos pesados e regeneráveis (o código-fonte dos modelos fica versionado)
/tools/blender/cache/
/tools/blender/cenas/
/tools/blender/saida/
/tools/blender/**/saida/
/tools/blender/**/cache/
/tools/blender/**/previas/
*.blend
*.blend1
# referências e capturas grandes da caverna
/docs/caverna/tripo/
/docs/caverna/conceitos/
/docs/caverna/blender/
/playwright-report/
/test-results/

# logs locais
.next-start.log
*.bak
